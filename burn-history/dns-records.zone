$ORIGIN home.arpa.
$TTL 300
@ IN SOA dns01.home.arpa. hostmaster.home.arpa. (
    2026110602  ; serial
    3600        ; refresh
    600         ; retry
    604800      ; expire
    300         ; negative cache TTL
)
@     IN NS dns01.home.arpa.
@     IN NS dns02.home.arpa.
@     IN NS dns03.home.arpa.
router        IN A 10.77.0.1
pve1          IN A 10.77.0.11
pve2          IN A 10.77.0.12
nas-synology1 IN A 10.77.0.21
nas-truenas1  IN A 10.77.0.23
pbs1          IN A 10.77.0.25
dns01 IN A 10.77.5.1
dns02 IN A 10.77.5.2
dns03 IN A 10.77.5.3
dns-api IN A 10.77.5.1
canary  IN A 10.77.9.9
