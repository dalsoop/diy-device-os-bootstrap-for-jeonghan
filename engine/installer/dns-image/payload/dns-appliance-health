#!/bin/bash
# SPDX-FileCopyrightText: 2026 dalsoop
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail

state_file=/etc/dns-appliance/install.env
overlay_selection=/etc/dns-appliance/overlays
output_dir=/var/lib/dns-appliance
metrics_dir=/var/lib/prometheus/node-exporter
token_file=/var/lib/dns-appliance/secrets/technitium-static-token
[ -s "$token_file" ] || { echo "dns-appliance-health: missing API token" >&2; exit 1; }
token=$(cat "$token_file")
ROLE=
ADDRESS=
while IFS='=' read -r key value; do
    case "$key" in
        ROLE) ROLE=$value ;;
        ADDRESS) ADDRESS=$value ;;
    esac
done < "$state_file"

probe() {
    if "$@" >/dev/null 2>&1; then
        printf '1'
    else
        printf '0'
    fi
}

probe_technitium() {
    curl --fail --silent --insecure --max-time 4 \
        -H "Authorization: Bearer $token" \
        https://127.0.0.1:53443/api/dnsClient/healthCheck |
        jq -e '.status == "ok"'
}

dns_udp=$(probe dig +time=2 +tries=1 +short @127.0.0.1 localhost A)
dns_tcp=$(probe dig +tcp +time=2 +tries=1 +short @127.0.0.1 localhost A)
technitium=$(probe probe_technitium)
cockpit=$(probe curl --fail --silent --insecure --max-time 4 https://127.0.0.1:9090/ping)
time_sync=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || printf 'no')
[ "$time_sync" = yes ] && ntp=1 || ntp=0

# Each selected overlay, and only those, is reported: its state, overlay
# address and hostname (and tags for Tailscale). An unreachable daemon reports
# "Unavailable" and up 0.
overlay_status() {
    case "$1" in
        tailscale)
            tailscale status --json 2>/dev/null |
                jq -c '{state: (.BackendState // "Unavailable"), ip: (.Self.TailscaleIPs[0] // ""),
                        hostname: (.Self.HostName // ""), tags: (.Self.Tags // [])}
                       | {up: (if .state == "Running" then 1 else 0 end)} + .'
            ;;
        netbird)
            netbird status --json 2>/dev/null |
                jq -c '{state: (if .management.connected == true then "Connected" else "Disconnected" end),
                        ip: (((.netbirdIp // "") | split("/")[0]) // ""),
                        hostname: (((.fqdn // "") | rtrimstr(".") | split(".")[0]) // "")}
                       | {up: (if .state == "Connected" then 1 else 0 end)} + .'
            ;;
    esac
}
selected_overlays=$(awk '
    $0 == "tailscale" && !tailscale && !netbird { tailscale = 1; print; next }
    $0 == "netbird" && !netbird { netbird = 1; print; next }
    { bad = 1 }
    END { exit (bad || NR == 0) }
' "$overlay_selection") || {
    echo "dns-appliance-health: invalid overlay selection in $overlay_selection" >&2
    exit 1
}
overlays='{}'
for overlay in $selected_overlays; do
    status=$(overlay_status "$overlay") || status=
    if [ -z "$status" ]; then
        status=$(jq -cn --arg name "$overlay" \
            '{up: 0, state: "Unavailable", ip: "", hostname: ""} + (if $name == "tailscale" then {tags: []} else {} end)')
    fi
    overlays=$(jq -cn --argjson overlays "$overlays" --arg name "$overlay" --argjson status "$status" \
        '$overlays + {($name): $status}')
done

install -d -m 0755 "$output_dir" "$metrics_dir"
jq -n --arg hostname "$ROLE" --arg address "$ADDRESS" \
    --argjson dns_udp "$dns_udp" --argjson dns_tcp "$dns_tcp" \
    --argjson technitium "$technitium" --argjson cockpit "$cockpit" \
    --argjson ntp "$ntp" --argjson overlays "$overlays" \
    --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{hostname:$hostname,address:$address,dns_udp:$dns_udp,dns_tcp:$dns_tcp,technitium:$technitium,cockpit:$cockpit,ntp_synchronized:$ntp,overlays:$overlays,checked_at:$checked_at}' \
    > "$output_dir/health.json.tmp"
mv "$output_dir/health.json.tmp" "$output_dir/health.json"

{
    printf '# HELP dns_appliance_service_up Service health (1 healthy, 0 unhealthy).\n'
    printf '# TYPE dns_appliance_service_up gauge\n'
    printf 'dns_appliance_service_up{service="dns_udp"} %s\n' "$dns_udp"
    printf 'dns_appliance_service_up{service="dns_tcp"} %s\n' "$dns_tcp"
    printf 'dns_appliance_service_up{service="technitium"} %s\n' "$technitium"
    printf 'dns_appliance_service_up{service="cockpit"} %s\n' "$cockpit"
    printf 'dns_appliance_service_up{service="ntp"} %s\n' "$ntp"
    printf '%s' "$overlays" |
        jq -r 'to_entries[] | "dns_appliance_service_up{service=\"\(.key)\"} \(.value.up)"'
} > "$metrics_dir/dns-appliance.prom.tmp"
mv "$metrics_dir/dns-appliance.prom.tmp" "$metrics_dir/dns-appliance.prom"

# Reboot guard state from dns-appliance-reboot: pending reboot, consecutive
# skipped reboot windows and the last skip time. Unreadable state removes the
# metrics rather than leaving stale values.
reboot_metrics=$metrics_dir/dns-appliance-reboot.prom
if /usr/local/sbin/dns-appliance-reboot metrics > "$reboot_metrics.tmp"; then
    mv "$reboot_metrics.tmp" "$reboot_metrics"
else
    rm -f "$reboot_metrics.tmp" "$reboot_metrics"
    echo "dns-appliance-health: reboot metrics are unavailable" >&2
fi

[ "$dns_udp" -eq 1 ] && [ "$dns_tcp" -eq 1 ] &&
    [ "$technitium" -eq 1 ] && [ "$cockpit" -eq 1 ]
