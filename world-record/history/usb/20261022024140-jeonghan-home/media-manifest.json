{
  "schema_version": 2,
  "distribution_policy": {
    "schema_version": 1,
    "source_release": {
      "enabled": true
    },
    "generated_artifacts": {
      "enabled": false
    },
    "prebuilt_release": {
      "enabled": false,
      "required_github_environment": "prebuilt-distribution"
    }
  },
  "product": {
    "name": "DIY Device OS USB for Jeonghan",
    "repository": "https://github.com/dalsoop/diy-device-os-bootstrap-for-jeonghan"
  },
  "catalog": {
    "repository": "https://github.com/dalsoop/diy-device-os-bootstrap-for-jeonghan",
    "revision": "63cd0f4cc0a71311ed239fdfdfe8f3315135f2f6",
    "tree": "da76b69ad34e5937cb9bb35a83879573478bb7fb",
    "path": "engine/catalog",
    "collection": "collections/device-os.json"
  },
  "usb": {
    "data_label": "DEVICE-OS",
    "enrollment_label": "DNS-ENROLL",
    "enrollment_reserve_mib": 2048,
    "capacity_overhead_mib": 768,
    "default_language": "ko_KR"
  },
  "bootloader": {
    "id": "ventoy",
    "implementation": "ventoy",
    "version": "1.1.18",
    "archive_root": "ventoy-1.1.18",
    "source": {
      "kind": "locked-download",
      "filename": "ventoy-1.1.18-linux.tar.gz",
      "url": "https://github.com/ventoy/Ventoy/releases/download/v1.1.18/ventoy-1.1.18-linux.tar.gz",
      "sha256": "d86ff9de63d94c8b8f1f6b14d23c55af4b88e8207bf2893890892a6a97b1ad54"
    },
    "redistribution": {
      "status": "personal-use-only"
    }
  },
  "groups": [
    {
      "id": "dns",
      "path": "images/01-dns",
      "menu_alias": "01 DNS 서버"
    },
    {
      "id": "virtualization",
      "path": "images/02-virtualization",
      "menu_alias": "02 가상화 및 백업"
    },
    {
      "id": "storage",
      "path": "images/03-storage",
      "menu_alias": "03 스토리지"
    },
    {
      "id": "desktop",
      "path": "images/04-desktop",
      "menu_alias": "04 데스크톱"
    },
    {
      "id": "tools",
      "path": "images/90-tools",
      "menu_alias": "90 점검 및 복구"
    }
  ],
  "entries": [
    {
      "id": "dns-appliance",
      "group": "dns",
      "destination": "images/01-dns/dns-appliance-installer.iso",
      "menu_alias": "Debian OS + DNS 서버 설치 (내부 디스크 삭제 주의)",
      "description_ko": "Debian OS와 DNS를 함께 설치합니다. 장비 식별·대상 디스크·재설치 승인 검사를 통과해야 합니다.",
      "description_en": "Installs Debian OS and DNS together after hardware, target-disk and reinstall checks.",
      "boot_behavior": "guarded-unattended",
      "profile_adapter": "dns-appliance",
      "redistribution": {
        "status": "personal-use-only"
      },
      "source": {
        "kind": "runtime-artifact",
        "manifest_digest_field": "iso_sha256",
        "manifest_destination": "manifests/dns-build-manifest.json",
        "manifest_schema": "engine/installer/schemas/dns-build-manifest.schema.json",
        "component_registry_filename": "component-redistribution-registry.json",
        "component_registry_digest_field": "component_registry_sha256",
        "component_registry_destination": "manifests/dns-component-redistribution-registry.json",
        "component_registry_schema": "engine/installer/schemas/component-redistribution-registry.schema.json",
        "distribution_policy_digest_field": "distribution_policy_sha256",
        "sbom_filename": "sbom.spdx.json",
        "sbom_digest_field": "sbom_sha256",
        "sbom_destination": "manifests/dns-sbom.spdx.json"
      },
      "final_review": {
        "required_for_status": "redistribution-reviewed",
        "record_filename": "dns-final-review-record.json",
        "record_destination": "manifests/dns-final-review-record.json",
        "schema": "engine/installer/schemas/dns-final-review-record.schema.json",
        "artifact_digest_field": "artifact.sha256",
        "component_registry_digest_field": "inputs.component_registry_sha256",
        "build_manifest_digest_field": "inputs.build_manifest_sha256"
      }
    }
  ],
  "bundles": [
    {
      "id": "dns-appliance-status-monitor",
      "destination": "tools/dns-appliance-status-monitor",
      "source": {
        "kind": "repository-tree",
        "path": "management/dns-appliance-status-monitor"
      }
    },
    {
      "id": "dns-inventory-capture",
      "destination": "tools/capture-inventory",
      "source": {
        "kind": "repository-file",
        "path": "dns-image/capture-inventory"
      }
    },
    {
      "id": "dns-disk-identity",
      "destination": "tools/disk-identity",
      "source": {
        "kind": "repository-file",
        "path": "dns-image/disk-identity"
      }
    },
    {
      "id": "dns-inventory-wizard",
      "destination": "tools/dns-inventory",
      "source": {
        "kind": "repository-file",
        "path": "dns-image/inventory-wizard"
      }
    },
    {
      "id": "dns-inventory-guide",
      "destination": "guides/DNS_INVENTORY.md",
      "source": {
        "kind": "repository-file",
        "path": "usb-media/guides/dns-inventory.md"
      }
    },
    {
      "id": "dns-install-guide",
      "destination": "guides/DNS_INSTALL.md",
      "source": {
        "kind": "repository-file",
        "path": "usb-media/guides/dns-install.md"
      }
    }
  ],
  "world": {
    "schema_version": 1,
    "source": {
      "playbook": "world-record/world-playbook.yaml",
      "world": "world-record/blueprint/home.yaml"
    },
    "world": {
      "name": "Jeonghan Home",
      "slug": "jeonghan-home",
      "lifecycle": "draft",
      "timezone": "Asia/Seoul"
    },
    "media": {
      "id": "dns-install",
      "language": "ko-KR",
      "entries": [
        "dns-appliance"
      ]
    },
    "policies": {
      "unattendedInstall": "guarded",
      "requireExactHardwareMatch": true,
      "requireSingleInternalTargetDisk": true,
      "requireTargetSpecificEraseConfirmation": true,
      "automaticBootTimeout": "disabled"
    }
  }
}
