{
  "schema_version": 1,
  "product": {
    "name": "DNS Install USB for Jeonghan",
    "repository": "https://github.com/dalsoop/dns-device-os-bootstrap-for-jeonghan"
  },
  "catalog": {
    "kind": "workspace",
    "path": "catalog",
    "index": "catalog/index.json",
    "bootloader": "ventoy"
  },
  "collection": "collections/device-os.json",
  "local_entries": [
    "usb-media/local-entries/dns-appliance.json"
  ],
  "usb": {
    "data_label": "DNS-INSTALL",
    "enrollment_label": "DNS-ENROLL",
    "enrollment_reserve_mib": 2048,
    "capacity_overhead_mib": 768,
    "default_language": "ko_KR"
  },
  "bundles": [
    {
      "id": "dns-appliance-status-monitor",
      "destination": "tools/dns-appliance-status-monitor",
      "source": { "kind": "repository-tree", "path": "management/dns-appliance-status-monitor" }
    },
    {
      "id": "dns-inventory-capture",
      "destination": "tools/capture-inventory",
      "source": { "kind": "repository-file", "path": "installer/capture-inventory" }
    },
    {
      "id": "dns-inventory-guide",
      "destination": "guides/DNS_INVENTORY.md",
      "source": { "kind": "repository-file", "path": "usb-media/guides/dns-inventory.md" }
    }
  ]
}
