# Debian 13 installer answers shared by all three appliances.

d-i debian-installer/locale string ko_KR.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i console-setup/ask_detect boolean false

# prepare-installer identifies the role before networking. Debian Installer
# only warns when a preseeded command fails and then continues, so the disk
# gate and the appliance setup are not preseeded commands: prepare-installer
# installs them as a partman init.d hook (a failure returns to the menu before
# any partitioning) and a finish-install hook (a failure backs up instead of
# rebooting into a bare system). Appliance setup needs both /cdrom and
# /target, so it runs there rather than as a simple-cdd postinst.
d-i preseed/early_command string /bin/sh /cdrom/simple-cdd/prepare-installer

d-i netcfg/disable_autoconfig boolean true
d-i netcfg/wireless_wep string

d-i mirror/country string manual
d-i apt-setup/use_mirror boolean false
d-i apt-setup/services-select multiselect
d-i apt-setup/non-free-firmware boolean true

d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string DNS Operator
d-i passwd/username string dns-operator
d-i passwd/user-password-crypted password !
d-i passwd/user-default-groups string audio cdrom dip plugdev sudo video

d-i clock-setup/utc boolean true
d-i time/zone string Asia/Seoul
d-i clock-setup/ntp boolean false

# The disk gate replaces this with the confirmed target. If the gate never ran,
# automatic partitioning names a disk that does not exist instead of taking
# the only visible disk, which may be the installer USB.
d-i partman-auto/disk string /dev/dns-appliance-target-not-confirmed
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-auto/purge_lvm_from_device boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/force-efi-extra-removable boolean false

tasksel tasksel/first multiselect
popularity-contest popularity-contest/participate boolean false

d-i cdrom-detect/eject boolean false
d-i finish-install/reboot_in_progress note
