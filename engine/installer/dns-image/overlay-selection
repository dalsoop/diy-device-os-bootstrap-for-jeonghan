# SPDX-License-Identifier: GPL-3.0-only
set -eu

# The DNS image bundles only the overlay clients that the World selects.
#   resolve               print the World's selection, one value per line, in
#                         the canonical order tailscale, netbird
#   check FILE            accept FILE only when it holds such a selection
#   notices FILE NOTICES  print NOTICES without the sections of overlays that
#                         FILE does not select
#   manifest MANIFEST     print the selection of a DNS build manifest in the
#                         canonical order
#   agree MANIFEST [PLAN] print the selection when the DNS build manifest's
#                         overlays equal, as a set, those of PLAN (a World plan
#                         or a resolved Catalog that embeds one) or, without
#                         PLAN, of the resolved World; refuse any difference

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
monorepo_root=$(CDPATH='' cd -- "$script_dir/../../.." && pwd)
resolver=$monorepo_root/engine/world/bin/resolve-world

fail() {
    echo "overlay-selection: $*" >&2
    exit 1
}

usage() {
    echo "usage: overlay-selection resolve | check FILE | notices FILE NOTICES | manifest MANIFEST | agree MANIFEST [PLAN]" >&2
    exit 2
}

# Print the selection held in a JSON value as a set: a non-empty array of
# unique values from the closed set, emitted in the canonical order. The jq
# variables are not shell expansions.
# shellcheck disable=SC2016
canonical_selection='
    if type == "array" and length > 0 and
       all(.[]; . == "tailscale" or . == "netbird") and
       ((unique | length) == length)
    then . as $selected | ["tailscale","netbird"][] | select(. as $overlay | $selected | index($overlay) != null)
    else error("invalid overlay selection") end'

manifest_selection() {
    { [ -f "$1" ] && [ -r "$1" ]; } || fail "DNS build manifest is not readable: $1"
    present=$(jq -r 'if type == "object" and has("overlays") then "yes" else "no" end' "$1" 2>/dev/null) ||
        fail "DNS build manifest is not JSON: $1"
    [ "$present" = yes ] || fail "DNS build manifest has no overlays; rebuild the DNS image with this checkout: $1"
    jq -r ".overlays | $canonical_selection" "$1" 2>/dev/null ||
        fail "DNS build manifest overlays must be a non-empty list of unique values from tailscale and netbird: $1"
}

plan_selection() {
    [ -r "$1" ] || fail "World plan is not readable: $1"
    jq -r "
        if type != \"object\" then error(\"no World plan\")
        elif has(\"overlays\") then .overlays
        elif (.world | type) == \"object\" and (.world | has(\"media\")) then .world.overlays
        else error(\"no World plan\") end | $canonical_selection" "$1" 2>/dev/null ||
        fail "World overlays must be a non-empty list of unique values from tailscale and netbird: $1"
}

listing() {
    printf '%s\n' "$1" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }'
}

agree() {
    image_selection=$(manifest_selection "$1")
    if [ "$#" -eq 2 ]; then
        world_selection=$(plan_selection "$2")
    else
        world_selection=$(resolve)
    fi
    [ "$image_selection" = "$world_selection" ] ||
        fail "DNS image overlays ($(listing "$image_selection")) differ from the World overlays ($(listing "$world_selection")); rebuild the DNS image for this World"
    printf '%s\n' "$image_selection"
}

check_file() {
    { [ -f "$1" ] && [ -s "$1" ]; } || fail "overlay selection is missing or empty: $1"
    awk '
        $0 == "tailscale" && !tailscale && !netbird { tailscale = 1; next }
        $0 == "netbird" && !netbird { netbird = 1; next }
        { bad = 1 }
        END { exit (bad || NR == 0) }
    ' "$1" || fail "overlay selection must list tailscale and/or netbird once each, one per line, in that order: $1"
}

resolve() {
    command -v ruby >/dev/null 2>&1 || fail "ruby is required to resolve the World"
    command -v jq >/dev/null 2>&1 || fail "jq is required"
    [ -x "$resolver" ] || fail "World resolver is missing: $resolver"
    plan=$(mktemp)
    trap 'rm -f "$plan"' EXIT HUP INT TERM
    if [ -n "${DEVICE_OS_WORLD:-}" ]; then
        "$resolver" --world "$DEVICE_OS_WORLD" > "$plan" || fail "the selected World cannot be resolved"
    else
        "$resolver" > "$plan" || fail "the World cannot be resolved"
    fi
    selection=$(jq -r '
        .overlays as $selected |
        if ($selected | type) == "array" and ($selected | length) > 0 and
           ($selected | all(.[]; . == "tailscale" or . == "netbird")) and
           (($selected | unique | length) == ($selected | length))
        then ["tailscale","netbird"][] | select(. as $overlay | $selected | index($overlay) != null)
        else error("invalid overlay selection") end
    ' "$plan" 2>/dev/null) ||
        fail "World overlays must be a non-empty list of unique values from tailscale and netbird"
    rm -f "$plan"
    trap - EXIT HUP INT TERM
    printf '%s\n' "$selection"
}

notices() {
    check_file "$1"
    [ -r "$2" ] || fail "notices are not readable: $2"
    awk -v selection_file="$1" '
        BEGIN {
            while ((getline line < selection_file) > 0) keep[line] = 1
            known["tailscale"] = 1
            known["netbird"] = 1
        }
        /^<!-- overlay:[a-z]+:(begin|end) -->$/ {
            name = $0
            sub(/^<!-- overlay:/, "", name)
            kind = name
            sub(/:(begin|end) -->$/, "", name)
            sub(/^[a-z]+:/, "", kind)
            sub(/ -->$/, "", kind)
            if (!(name in known)) { bad = 1; next }
            if (kind == "begin") {
                if (open != "" || begins[name]++) { bad = 1 }
                open = name
                if (!(name in keep)) { skipping = 1; next }
            } else {
                if (open != name || ends[name]++) { bad = 1 }
                open = ""
                if (skipping) { skipping = 0; eat_blank = 1; next }
            }
            print
            next
        }
        /overlay:/ && /<!--/ { bad = 1 }
        skipping { next }
        eat_blank && $0 == "" { eat_blank = 0; next }
        { eat_blank = 0; print }
        END {
            if (open != "") bad = 1
            for (name in known) if (begins[name] != 1 || ends[name] != 1) bad = 1
            exit bad
        }
    ' "$2" || fail "notices must mark every overlay section exactly once: $2"
}

case "${1:-}" in
    resolve)
        [ "$#" -eq 1 ] || usage
        resolve
        ;;
    check)
        [ "$#" -eq 2 ] || usage
        check_file "$2"
        ;;
    notices)
        [ "$#" -eq 3 ] || usage
        notices "$2" "$3"
        ;;
    manifest)
        [ "$#" -eq 2 ] || usage
        command -v jq >/dev/null 2>&1 || fail "jq is required"
        manifest_selection "$2"
        ;;
    agree)
        { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } || usage
        command -v jq >/dev/null 2>&1 || fail "jq is required"
        shift
        agree "$@"
        ;;
    *) usage ;;
esac
